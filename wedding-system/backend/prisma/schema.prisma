// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WeddingStatus {
  PLANNING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Wedding {
  id              Int           @id @default(autoincrement())

  // Casal
  bride_name      String        @db.VarChar(150)
  groom_name      String        @db.VarChar(150)
  couple_email    String        @db.VarChar(150)
  couple_phone    String        @db.VarChar(20)

  // Evento
  wedding_date    DateTime      @db.Date
  venue           String        @db.VarChar(300)
  city            String        @db.VarChar(100)
  state           String        @db.VarChar(2)
  estimated_guests Int          @default(0)

  // Financeiro
  total_budget    Decimal       @db.Decimal(12, 2)

  // Controle
  status          WeddingStatus @default(PLANNING)
  notes           String?       @db.Text

  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  @@map("weddings")
}
